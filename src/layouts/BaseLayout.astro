---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Paul Wheatcroft — Product Developer',
  description = 'Product developer building BandSynq and Cocktail Shaker. Independent label owner, multi-instrumentalist, songwriter, and producer.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/portrait.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Sedgwick+Ave+Display&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <footer class="footer">
      <div class="container footer__inner">
        <p>&copy; {new Date().getFullYear()} Paul Wheatcroft</p>
        <p class="footer__domain">paulwheatcroft.me</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .footer {
    padding-block: 2rem 2.5rem;
    border-top: 1px solid rgba(242, 236, 228, 0.06);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .footer__inner p {
    margin: 0;
  }

  .footer__domain {
    font-family: var(--font-display);
    letter-spacing: 0.08em;
    color: var(--accent-pink);
    opacity: 0.7;
  }
</style>
