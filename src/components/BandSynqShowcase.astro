---
import { Image } from 'astro:assets';
import logo from '../assets/bandsynq-logo.png';

interface Panel {
  name: string;
  platform: string;
  summary: string;
  stack: string[];
}

const panels: Panel[] = [
  {
    name: 'BandSynq',
    platform: 'Web app',
    summary:
      'Where artists configure their setlists. Installable as a PWA.',
    stack: [
      'Vue 3',
      'TypeScript',
      'Quasar',
      'Pinia',
      'Vue Router',
      'Vite',
      'PWA (Workbox)',
      'Supabase',
      'PostgreSQL',
      'Auth',
      'Storage',
      'Realtime',
      'Edge Functions',
      'Stripe',
      'Vitest',
      'Cypress',
      'Vercel',
    ],
  },
  {
    name: 'BandSynq Stage',
    platform: 'iOS app',
    summary:
      'The offline-first live-performance companion.',
    stack: [
      'Expo SDK 57',
      'React Native 0.86',
      'React 19',
      'TypeScript',
      'Expo Router',
      'NativeWind',
      'SQLite',
      'Expo Audio',
      'Supabase',
      'Expo IAP',
      'EAS Build & Submit',
    ],
  },
];
---

<article class="showcase" aria-labelledby="bandsynq-heading">
  <div class="showcase__accent" aria-hidden="true"></div>

  <header class="showcase__header">
    <div class="showcase__brand">
      <span class="showcase__label">featured</span>
      <Image
        src={logo}
        alt="BandSynq"
        width={1200}
        widths={[480, 800, 1200]}
        sizes="(max-width: 768px) 80vw, 360px"
        class="showcase__logo"
        loading="lazy"
      />
    </div>
    <p class="showcase__launch">
      <span class="showcase__launch-dot" aria-hidden="true"></span>
      BandSynq Stage launches November 2026
    </p>
  </header>

  <h3 id="bandsynq-heading" class="showcase__tagline">Back Yourself</h3>
  <p class="showcase__intro">
    The simplest way to take your backing tracks to the stage. BandSynq is the web app for artists
    to configure their setlists. BandSynq Stage is the iOS companion that plays those backing
    tracks live, fully offline.
  </p>

  <div class="showcase__panels">
    {
      panels.map(({ name, platform, summary, stack }) => (
        <section class="panel" aria-label={`${name} ${platform}`}>
          <p class="panel__platform">{platform}</p>
          <h4 class="panel__name">{name}</h4>
          <p class="panel__summary">{summary}</p>
          <ul class="panel__stack" aria-label={`${name} technology stack`}>
            {stack.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <dl class="showcase__details">
    <div class="showcase__row">
      <dt>Proven on stage</dt>
      <dd>
        I have gigged with it. BandSynq Stage has run my own backing tracks at live performances,
        which is where most of the design decisions came from.
      </dd>
    </div>
    <div class="showcase__row">
      <dt>What is it?</dt>
      <dd>
        Founder-led product from scratch. Accepted on Bath Spa University's Create Growth programme.
      </dd>
    </div>
  </dl>

  <div class="showcase__links">
    <a href="https://www.bandsynq.com" class="btn btn--orange" target="_blank" rel="noopener noreferrer">
      bandsynq.com
    </a>
  </div>
</article>

<style>
  .showcase {
    --accent-orange: #ff9800;
    --accent-green: #b8e986;
    --accent-green-deep: #51683a;
    position: relative;
    background: #161412;
    border: 1px solid rgba(255, 152, 0, 0.35);
    border-left: 6px solid var(--accent-orange);
    padding: 2.25rem 2.5rem 2.5rem;
    margin-bottom: 3rem;
    transform: rotate(-0.4deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase {
      transform: none;
    }
  }

  .showcase__accent {
    position: absolute;
    top: -10px;
    right: 1.5rem;
    width: 72px;
    height: 72px;
    background: var(--accent-green-deep);
    opacity: 0.6;
    border-radius: 50%;
  }

  .showcase__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 1.75rem;
  }

  .showcase__brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .showcase__label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-green);
  }

  .showcase__logo {
    width: min(360px, 80vw);
    height: auto;
  }

  .showcase__launch {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0;
    padding: 0.45rem 0.9rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent-orange);
    transform: rotate(0.8deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__launch {
      transform: none;
    }
  }

  .showcase__launch-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-top: 0.35em;
    border-radius: 50%;
    background: var(--bg);
  }

  .showcase__tagline {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .showcase__intro {
    color: var(--text-muted);
    max-width: 65ch;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .showcase__panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .panel {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-top: 3px solid var(--accent-orange);
    padding: 1.5rem 1.5rem 1.6rem;
  }

  .panel__platform {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-green);
    margin: 0 0 0.25rem;
  }

  .panel__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    line-height: 1.1;
    color: var(--text);
    margin: 0 0 0.75rem;
  }

  .panel__summary {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.55;
    margin-bottom: 1.1rem;
  }

  .panel__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chip {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-green);
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(184, 233, 134, 0.35);
    background: rgba(81, 104, 58, 0.25);
  }

  .showcase__details {
    margin: 0 0 1.75rem;
  }

  .showcase__row {
    margin-bottom: 1rem;
  }

  .showcase__row:last-child {
    margin-bottom: 0;
  }

  .showcase__row dt {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-green);
    margin-bottom: 0.25rem;
  }

  .showcase__row dd {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 65ch;
  }

  .showcase__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn--orange {
    border-color: var(--accent-orange);
  }

  .btn--orange:hover {
    background: var(--accent-orange);
    color: var(--bg);
  }

  @media (max-width: 768px) {
    .showcase {
      padding: 1.75rem 1.5rem 2rem;
    }

    .showcase__header {
      align-items: flex-start;
    }

    .showcase__panels {
      grid-template-columns: 1fr;
    }
  }
</style>
