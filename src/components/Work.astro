---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
---

<Section title="Personal projects" id="personal-projects">
  <ProjectCard
    title="BandSynq"
    featured
    tilt="left"
    problem="Grassroots bands juggle songs, setlists, and rehearsals across chats, notes, and memory."
    built="Cross-platform app built with Vue, Quasar, TypeScript, and Supabase — architecture, backend, and UX. User interviews and closed beta with working bands."
    signal="Founder-led product from scratch. Not a portfolio filler — a real tool shaped by the people who use it."
    links={[
      { href: 'https://www.bandsynq.com', label: 'bandsynq.com' },
    ]}
  />
  <ProjectCard
    title="Cocktail Shaker"
    tilt="right"
    problem="Ingredient-led cocktail discovery should be grounded in real data — not random AI-generated recipes."
    built="Vue app with in-app ranking and a conversational hostess for presentation. Supabase edge functions handle the AI layer."
    signal="Product taste over hype. The ranking and discovery UX is the product; AI is a presentation layer."
    links={[
      { href: 'https://cocktail-shaker-six.vercel.app/', label: 'Live app', variant: 'teal' },
      { href: 'https://github.com/PaulWheatcroft/cocktail-shaker-2', label: 'GitHub' },
    ]}
  />
</Section>

<style>
  :global(#personal-projects) {
    background: rgba(61, 52, 46, 0.15);
  }
</style>
