---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import BandSynqShowcase from './BandSynqShowcase.astro';
---

<Section title="Personal" id="personal">
  <BandSynqShowcase />
  <ProjectCard
    title="Cocktail Shaker"
    tilt="right"
    problem="Knowing what to make with what you have. It should be grounded in real data, not random AI-generated recipes."
    built="Vue app with in-app AI ranking and a conversational AI hostess for presentation. Supabase edge functions handle the AI layer. OpenAI provides the language model."
    signal="Cocktail recommendations anchored in a data API wrapped in an AI is a presentation layer."
    links={[
      { href: 'https://cocktail-shaker-six.vercel.app/', label: 'Live app', variant: 'teal' },
      { href: 'https://github.com/PaulWheatcroft/cocktail-shaker-2', label: 'GitHub' },
    ]}
  />
</Section>

<style>
  :global(#personal) {
    background: rgba(61, 52, 46, 0.15);
  }
</style>
